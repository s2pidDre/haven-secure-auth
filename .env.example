# Run npm run setup to generate your own .env and localhost TLS certificate.
# Never share .env, certs/, or data/.
APP_ORIGIN=https://localhost:3443
HOST=127.0.0.1
PORT=3443
TRANSPORT=direct
TLS_CERT=certs/localhost.pem
TLS_KEY=certs/localhost-key.pem
DATA_DIR=data
# setup generates an unpredictable 64-character hexadecimal value here.
APP_SECRET=
# Optional online compromised-password screening. Requires outbound HTTPS.
# A network failure blocks registration when this is true.
HIBP_CHECK=false

# Optional Turso database. Leave both blank for LOCAL SQLite.
# The Render Free blueprint requires both and never falls back to local storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
